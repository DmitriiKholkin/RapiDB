# Fail closed: local .env files, credentials, keys, and unexpected artifacts
# must never become extension assets just because they exist in the workspace.
**
!package.json
!README.md
!LICENSE.md
!CHANGELOG.md
!dist/extension.js
!dist/sqliteWorker.js
!dist/webview.js
!dist/webview.css
!media/icon-app.png
!media/icon-market.png

# Preserve the existing external dependency/runtime closure, including any
# package-owned certificates or keys. These are trusted dependency roots, not
# locations for local credentials. Do not broaden the application paths above.
# vsce negations override exclusions regardless of order: a broad !dist/** or
# !media/** cannot be made safe by appending .env / *.key exclusion patterns.
!node_modules/oracledb/**
!.rapidb-runtime/node_modules/better-sqlite3/**
!.rapidb-runtime/node_modules/bindings/**
!.rapidb-runtime/node_modules/file-uri-to-path/**
!node_modules/ssh2/package.json
!node_modules/ssh2/LICENSE
!node_modules/ssh2/lib/*.js
!node_modules/ssh2/lib/protocol/*.js
!node_modules/ssh2/lib/protocol/crypto/poly1305.js
!node_modules/asn1/package.json
!node_modules/asn1/LICENSE
!node_modules/asn1/lib/**/*.js
!node_modules/safer-buffer/package.json
!node_modules/safer-buffer/LICENSE
!node_modules/safer-buffer/safer.js
!node_modules/bcrypt-pbkdf/package.json
!node_modules/bcrypt-pbkdf/LICENSE
!node_modules/bcrypt-pbkdf/index.js
!node_modules/tweetnacl/package.json
!node_modules/tweetnacl/LICENSE
!node_modules/tweetnacl/nacl-fast.js

# Because negations win, Oracle thick-mode leftovers (build/, examples/,
# package/, *-buildinfo.txt, docs, .DS_Store) cannot be excluded here; they are
# removed by scripts/prepare-vscode-package.mjs before packaging.
